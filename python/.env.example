# 复制本文件为 .env 并填入你的 API Key（ReportAgent 故障报告生成用）
# 不配置也不影响其余功能：report 节点会被自动跳过

# LLM 配置（OpenAI 兼容接口，默认 DeepSeek；换其他兼容服务只需改 BASE_URL/MODEL）
AIOPS_OPENAI_API_KEY=sk-xxxx
AIOPS_OPENAI_BASE_URL=https://api.deepseek.com
AIOPS_OPENAI_MODEL=deepseek-chat

# 可选：LLM 调用超时（秒），默认 30
# AIOPS_LLM_TIMEOUT_SECONDS=30

# 可选：真实基础设施模式开关（默认 false，用内存实现）
# AIOPS_USE_KAFKA=true
# AIOPS_USE_NEO4J=true
